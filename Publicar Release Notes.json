    {
      "parameters": {
        "jsCode": "const body = $('Receber Publicação').first().json.body;\nconst version = body.version || '?';\nconst tasks = body.tasks || [];\n\nfunction limparTitulo(titulo) {\n  return (titulo || '').replace(/^bug\\s*[-–:]\\s*/i, '').trim();\n}\n\nfunction getClassificacao(task) {\n  return (task.classificacao || 'MELHORIA').toUpperCase() === 'BUG' ? 'BUG' : 'MELHORIA';\n}\n\nconst mapa = {};\ntasks.forEach(function(task) {\n  const clienteTags = (task.tags || []).filter(t => t.name?.toLowerCase().startsWith('c:'));\n  const clientes = clienteTags.length > 0\n    ? clienteTags.map(t => t.name.substring(2).trim().toUpperCase())\n    : ['TODOS OS CLIENTES'];\n  const modulo = task.modulo || 'Geral';\n  const titulo = limparTitulo(task.titulo || task.name);\n  const classificacao = getClassificacao(task);\n\n  clientes.forEach(function(cliente) {\n    if (!mapa[cliente]) mapa[cliente] = {};\n    if (!mapa[cliente][modulo]) mapa[cliente][modulo] = { BUG: [], MELHORIA: [] };\n    mapa[cliente][modulo][classificacao].push(titulo);\n  });\n});\n\nconst clientesOrdenados = Object.keys(mapa).sort(function(a, b) {\n  if (a === 'TODOS OS CLIENTES') return 1;\n  if (b === 'TODOS OS CLIENTES') return -1;\n  return a.localeCompare(b, 'pt-BR');\n});\n\nlet totalBugs = 0, totalMelhorias = 0;\ntasks.forEach(t => {\n  getClassificacao(t) === 'BUG' ? totalBugs++ : totalMelhorias++;\n});\n\nconst dataHoje = new Date().toLocaleDateString('pt-BR');\nconst div = '────────────────────────────────────────────────────';\n\n// Cabeçalho\nlet texto = `🚀 *Release Notes ${version}*\\n`;\ntexto += `📅 ${dataHoje}`;\n\nconst resumo = [];\nif (totalBugs > 0)      resumo.push(`🔴 ${totalBugs} correção(ões)`);\nif (totalMelhorias > 0) resumo.push(`🟢 ${totalMelhorias} melhoria(s)`);\nif (resumo.length > 0)  texto += `  ·  ${resumo.join('  ·  ')}`;\ntexto += '\\n';\n\ntexto += `\\n📋 *Encaminhamentos por cliente*\\n`;\ntexto += `Itens separados para direcionamento das atualizações e comunicações.\\n`;\n\n// Corpo por cliente\nclientesOrdenados.forEach(function(cliente) {\n  const icone = cliente === 'TODOS OS CLIENTES' ? '👥' : '🏢';\n  texto += `\\n${div}\\n`;\n  texto += `${icone} *${cliente}*\\n`;\n\n  const modulos = mapa[cliente];\n  Object.keys(modulos).sort().forEach(function(modulo) {\n    const bugs = modulos[modulo].BUG;\n    const melhorias = modulos[modulo].MELHORIA;\n    if (bugs.length === 0 && melhorias.length === 0) return;\n\n    texto += `\\n📁 *${modulo}*\\n`;\n\n    if (bugs.length > 0) {\n      texto += `\\n🔴 Correções:\\n`;\n      bugs.forEach(t => { texto += `- ${t}\\n`; });\n    }\n\n    if (melhorias.length > 0) {\n      texto += `\\n🟢 Melhorias:\\n`;\n      melhorias.forEach(t => { texto += `- ${t}\\n`; });\n    }\n  });\n});\n\ntexto += `\\n${div}\\n`;\n\nreturn [{ json: { mensagem: texto, version } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
